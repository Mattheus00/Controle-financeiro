# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Folio

# Supabase — use as chaves publicáveis no client.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY em variável NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Apenas servidor. Não expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Folio

# Supabase — use as chaves publicáveis no client.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY em variável NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Apenas servidor. Não expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# OCR / Vision do ReceiptProcessor (servidor). OPENAI_API_KEY é a usada pelo código.
OPENAI_API_KEY=
OCR_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Privacidade / contato do controlador (não hardcodar nas páginas)
PRIVACY_CONTACT_EMAIL=
DATA_PROTECTION_CONTACT_NAME=
DATA_PROTECTION_CONTACT_EMAIL=
